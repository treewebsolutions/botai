# Prevent directory listings
Options -Indexes
IndexIgnore */*

# Follow symbolic links
Options FollowSymlinks

<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteBase /

	# Redirect to HTTPS without www
	RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]


    # DOCUMENTATION
    RewriteRule ^documentation/?(.*)$ documentation/$1 [NC,L]

    # PRESENTATION (static Bootstrap page + Markdown docs)
    RewriteRule ^docs/?$ docs/index.html [NC,L]
    RewriteRule ^docs/(.+)$ docs/$1 [NC,L]
	
	# REST API
	RewriteCond %{REQUEST_URI} /(api/v\d+)
	RewriteRule ^api/?(.*)$ master/api/public/$ [L]

	# BEGIN Workspace Rules
	# Managed by master (Workspace::updateHtaccess()). One rule per installed tenant, e.g.:
	#RewriteRule ^example/?(.*)$ workspaces/example.ro/$1 [NC,L]
	# END Workspace Rules

	# Set master as default application
	RewriteRule ^(.+)?$ master/$1
</IfModule>
