# Prevent directory listings
Options -Indexes
IndexIgnore */*

# Follow symbolic links
Options FollowSymlinks

<IfModule mod_rewrite.c>
	RewriteEngine on

	# REST API
	RewriteCond %{REQUEST_URI} /(api/v\d+)
	RewriteRule ^api/?(.*)$ api/web/$ [L]

	# Allow access to files from public uploads directory
	RewriteCond %{REQUEST_URI} /(uploads)
	RewriteRule ^uploads/(.*)$ uploads/$1 [L]

	# Set backend application
	RewriteRule ^admin/?(.*)$ backend/web/$1 [NC,L]

	# Set frontend as default application
	RewriteRule ^(.+)?$ frontend/web/$1
</IfModule>
