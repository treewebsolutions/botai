# -----------------------------------------------------------------------------
# Docker environment configuration for the AVPS Yii2 advanced project
# (master app + workspace tenants, see ../.htaccess for the routing).
#
#   cp .env.example .env
#
# Everything in this file is consumed by docker-compose.yml, docker/setup.sh,
# docker/setup.bat and - via Apache env variable substitution - by the Apache
# vhost `docker/apache/apache.conf` at container startup.
# -----------------------------------------------------------------------------

# Logical project name. Used as:
#   - container name prefix (botai_web, botai_db, ...)
#   - HTTP ServerName for the Apache vhost (https://<PROJECT_NAME>/)
#   - self-signed SSL cert filenames: docker/apache/ssl/<PROJECT_NAME>.{crt,key}
#   - default MySQL database name (can be overridden below)
PROJECT_NAME=botai

# --- Host-side ports -------------------------------------------------------
# Change these if another service on the host already binds them. Laragon's
# Apache binds 80/443 and MySQL binds 3306 - stop it before `docker compose up`
# or reassign the ports here.
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=3306
PMA_PORT=82

# --- Database --------------------------------------------------------------
# Local MySQL is rooted with the password `mysql` so DB_PASSWORD ==
# DB_ROOT_PASSWORD and both common/config/main-local.php and phpMyAdmin keep
# working out of the box. The botai stack expects one database per app -
# by default the master app lives in `botai_master` (this DB) and each tenant
# workspace gets its own DB created in MySQL (see ../workspace/_database/store.sql).
DB_NAME=botai_master
DB_USER=root
DB_PASSWORD=mysql
DB_ROOT_PASSWORD=mysql

# --- phpMyAdmin ------------------------------------------------------------
# Sub-URI served by the phpMyAdmin container. Both / and this path work.
PMA_SUB_URI=/phpmyadmin/
#
# Open phpMyAdmin at: http://localhost:<PMA_PORT><PMA_SUB_URI>
# e.g. http://localhost:82/phpmyadmin/
# Use that exact URL: if PMA_ABSOLUTE_URI in compose does not match your browser
# address, AJAX breaks ("Error in processing request").

# --- Web server ------------------------------------------------------------
# Apache DocumentRoot inside the container. The project source is always
# mounted at /var/www/html; point WEB_DOCROOT at whatever subdirectory your
# framework serves from. Examples:
#
#   WEB_DOCROOT=/var/www/html                 # botai default - the repo-root
#                                             # .htaccess routes /api -> master/api/web/,
#                                             # /ajvps* and /botai* -> workspace/workspaces/<id>/,
#                                             # everything else -> master/
#   WEB_DOCROOT=/var/www/html/master/frontend/web
#                                             # serve the master Yii2 frontend directly
#                                             # (bypasses .htaccess workspace routing)
WEB_DOCROOT=/var/www/html

# --- Extra PHP / apt additions --------------------------------------------
# Only set these if the project needs something the default image doesn't
# already provide. They're passed as build args to docker/Dockerfile.
#
# Examples:
#   EXTRA_APT_PACKAGES=libpq-dev libwebp-dev
#   EXTRA_PHP_EXTENSIONS=pdo_pgsql redis imagick
EXTRA_APT_PACKAGES=
EXTRA_PHP_EXTENSIONS=
