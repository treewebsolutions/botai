# Prevent directory listings
Options -Indexes
IndexIgnore */*

# Follow symbolic links
Options FollowSymlinks

<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteBase /

	# Redirect to the non-www version
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

	# DOCUMENTATION
	RewriteRule ^documentation/?(.*)$ documentation/$1 [NC,L]
	
	# REST API
	RewriteCond %{REQUEST_URI} /(api/v\d+)
	RewriteRule ^api/?(.*)$ master/api/web/$ [L]

	# BEGIN Workspace Rules
	# Managed by master (Workspace::updateHtaccess()). One rule per installed tenant, e.g.:
	#RewriteRule ^example/?(.*)$ workspaces/example.ro/$1 [NC,L]
	# END Workspace Rules

	# Set master as default application
	RewriteRule ^(.+)?$ master/$1
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
