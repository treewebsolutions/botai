# Uploaded files are user-controlled, and the app .htaccess routes /uploads/
# straight at this directory, so nothing here may ever be executed or served
# as anything but inert content.

# FollowSymlinks stays on: the app .htaccess enables it and the document
# root is a mounted volume, so revoking it here 403s every file.
Options -ExecCGI -Indexes
IndexIgnore */*

# 1. Take the file away from every script engine, whatever the extension says.
<IfModule mod_php.c>
	php_flag engine off
</IfModule>
<IfModule mod_php7.c>
	php_flag engine off
</IfModule>
<IfModule mod_php8.c>
	php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .phps .pl .py .cgi .sh .shtml
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .phps
<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]?|phps|pl|py|cgi|sh|shtml|html?|htaccess)$">
	SetHandler default-handler
</FilesMatch>

# 2. Serve only the types the apps actually store, and deny everything else.
#    Apache 2.4 first; the 2.2 syntax is kept for hosts without mod_authz_core.
<IfModule mod_authz_core.c>
	Require all denied
	<FilesMatch "(?i)\.(jpe?g|png|gif|webp|ico|pdf|csv|xlsx?|docx?|pptx?|zip|vcf|css)$">
		Require all granted
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	<FilesMatch "(?i)\.(jpe?g|png|gif|webp|ico|pdf|csv|xlsx?|docx?|pptx?|zip|vcf|css)$">
		Allow from all
	</FilesMatch>
</IfModule>

# 3. Never let a browser sniff a stored file into something executable.
#    setifempty, not "always set", so this does not duplicate the value the
#    document-root .htaccess already sends.
<IfModule mod_headers.c>
	Header setifempty X-Content-Type-Options "nosniff"
</IfModule>
